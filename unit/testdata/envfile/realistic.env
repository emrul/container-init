# Realistic env file -- typical of what an entrypoint exports.
# Mixed simple values, paths, comments (# and ;), and feature flags.

RESOLUTION=1280x800
COL_DEPTH=24
LISTEN_PORT=6901
MAX_FRAME_RATE=24
APP_PATH=/usr/share/myapp
DRINODE=/dev/dri/renderD128

; Orchestration vars
API_HOST=api
API_PORT=443

# Service toggles (defaulted on; set to 0 to gate units off)
FEATURE_WEB=1
FEATURE_PROFILE_PULL=1
FEATURE_AUDIO=1
FEATURE_AUDIO_INPUT=1
FEATURE_UPLOADS=1
FEATURE_GAMEPAD=1
FEATURE_WEBCAM=1
FEATURE_PRINTER=1
FEATURE_SMARTCARD=1
