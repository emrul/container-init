# Quoting forms drawn from systemd's documented EnvironmentFile semantics.
# The corresponding .want file pins the exact unquoted/expanded result.

PLAIN=hello
WITH_SPACES_TRIMMED=   trimmed
DQ_PLAIN="double-quoted"
SQ_PLAIN='single-quoted'
DQ_WITH_DQ="he said \"hi\""
SQ_WITH_DQ='he said "hi"'
SQ_WITH_BS='backslash \n stays literal'
CONCAT=foo'bar'"baz"
EMPTY_DQ=""
EMPTY_SQ=''
DQ_WITH_DOLLAR="literal $1 \$"
LEADING_TRAILING_WS=  unq
