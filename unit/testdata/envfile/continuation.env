# Line continuation — trailing backslash joins the next physical line.

ARGS=--listen 127.0.0.1:4902 \
     --upload-dir /home/app/Uploads \
     --max-size 1G

DQ_SPAN="line1\
line2\
line3"

# Even-length backslash run at end of line is NOT a continuation:
# the trailing pair is a literal "\\" preserved verbatim.
LITERAL_BS=foo\\
KEEP_GOING=ok
